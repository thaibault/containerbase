  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaibault/containerbase.git"
  },
  "main": "scripts/initialize.sh",
  "files": [
    "Dockerfile",
    "scripts",
    "service"
  ],
  "scripts": {
    "lint": "shellcheck -x scripts/*.sh test/*.sh testAdvanced/*.sh testEnvironment/*.sh",
    "lint:given": "shellcheck -x",
    "start": "docker compose --file service/docker-compose.yaml up",
    "test": "bash ./test/crypt.sh",
    "update:documentation": "web-documentation"
  },
