{
  "name": "containerbase",
  "version": "1.0.254",
  "description": "generic containerized application",
  "keywords": [
    "application",
    "archLinux",
    "arch",
    "container",
    "hosting",
    "linux"
  ],
  "homepage": "https://tsickert.com/containerbase",
  "bugs": {
    "email": "info@tsickert.com",
    "url": "https://github.com/thaibault/containerbase/issues"
  },
  "license": "CC-BY-3.0",
  "author": {
    "email": "info@tsickert.com",
    "name": "Torben Sickert",
    "url": "https://tsickert.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thaibault/containerbase"
  },
  "main": "scripts/initialize.sh",
  "files": [
    "Dockerfile",
    "scripts",
    "service"
  ],
  "scripts": {
    "lint": "hash shellcheck && shellcheck -x **/*.sh || echo Please install \"shellcheck\". || true",
    "lint:given": "shellcheck -x",
    "start": "docker compose --file service/docker-compose.yaml up",
    "update:documentation": "web-documentation"
  },
  "devDependencies": {
    "bashlink": "^1.0.280",
    "web-documentation": "^1.0.60"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webDocumentation": {
    "tagline": "containerize your application",
    "trackingCode": "UA-40192634-TODO"
  },
  "packageManager": "yarn@4.18.0"
}
